<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared layout for StateView.

    One card that can present any of the four UI states required by the
    prototype brief (loading / empty / error / success). StateView shows and
    hides the individual rows below; nothing here is state-specific on its own.

    Merged into StateView so the component adds no extra view group.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <!-- Loading spinner: visible for the loading state only. -->
    <ProgressBar
        android:id="@+id/state_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="@color/brand_orange"
        android:visibility="gone" />

    <!-- Illustrative icon: empty / error / success states. -->
    <ImageView
        android:id="@+id/state_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:alpha="0.6"
        android:contentDescription="@null"
        android:visibility="gone" />

    <TextView
        android:id="@+id/state_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/state_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Retry affordance: error state only, shown when a handler is supplied. -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/state_retry"
        style="@style/SecondaryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="0dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:text="@string/state_retry"
        android:visibility="gone" />
</merge>
