<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <View android:id="@+id/dot" android:layout_width="8dp" android:layout_height="8dp"
        android:background="@drawable/dot_green" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
        <TextView android:id="@+id/agent_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AGENT-001" android:textColor="@color/text_primary"
            android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/agent_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="192.168.1.10 · Windows 10" android:textColor="@color/text_muted"
            android:textSize="12sp" android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/agent_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="2m ago" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="check-in" android:textColor="@color/text_muted" android:textSize="11sp" />
    </LinearLayout>

    <ImageView android:layout_width="18dp" android:layout_height="18dp"
        android:layout_marginStart="6dp" android:src="@drawable/ic_chevron_right" />
</LinearLayout>
