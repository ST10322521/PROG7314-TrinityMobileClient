<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_appbar_orange"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/console_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Agent Command Console"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                style="@style/TrinityCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/LabelCaps"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Target agent" />

                <EditText
                    android:id="@+id/input_agent_id"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp"
                    android:hint="Agent ID (e.g. 1)"
                    android:inputType="number"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView style="@style/LabelCaps"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Channel" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView android:id="@+id/chip_powershell"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_page" android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp" android:text="PowerShell"
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:clickable="true" android:focusable="true" />

                    <TextView android:id="@+id/chip_shell"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_page" android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp" android:text="Shell"
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:clickable="true" android:focusable="true" />

                    <TextView android:id="@+id/chip_run"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_page" android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp" android:text="Run"
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>

                <TextView style="@style/LabelCaps"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Command" />

                <EditText
                    android:id="@+id/input_command"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp"
                    android:hint="whoami"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/btn_send"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_appbar_orange"
                    android:gravity="center"
                    android:text="Send Command"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                style="@style/TrinityCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <TextView style="@style/LabelCaps"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Console output" />

                <TextView
                    android:id="@+id/console_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_console"
                    android:padding="12dp"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="@color/status_green"
                    android:text="Ready." />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
