<?xml version="1.0" encoding="utf-8"?><androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Payloads" android:textColor="@color/text_primary"
            android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Generate and manage payloads" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:layout_marginTop="2dp" />

        <!-- Generate card -->
        <LinearLayout style="@style/TrinityCard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Generate Payload" android:textColor="@color/text_primary"
                android:textSize="16sp" android:textStyle="bold" />

            <TextView style="@style/LabelCaps" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Listener" android:layout_marginTop="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_input"
                android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:drawableEnd="@drawable/ic_chevron_down"
                android:text="Select a listener"
                android:textColor="@color/text_muted" android:textSize="14sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/LabelCaps" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Type" />
                    <TextView android:layout_width="match_parent" android:layout_height="46dp"
                        android:layout_marginTop="6dp" android:background="@drawable/bg_input"
                        android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:drawableEnd="@drawable/ic_chevron_down"
                        android:text="Executable" android:textColor="@color/text_primary" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView style="@style/LabelCaps" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Arch" />
                    <TextView android:layout_width="match_parent" android:layout_height="46dp"
                        android:layout_marginTop="6dp" android:background="@drawable/bg_input"
                        android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:drawableEnd="@drawable/ic_chevron_down"
                        android:text="x64" android:textColor="@color/text_primary" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/LabelCaps" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Output Format" android:layout_marginTop="14dp" />
            <TextView android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_input"
                android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:drawableEnd="@drawable/ic_chevron_down"
                android:text="Windows EXE (.exe)" android:textColor="@color/text_primary" android:textSize="14sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Stageless payload" android:textColor="@color/text_primary" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Embed full agent (larger file)" android:textColor="@color/text_muted" android:textSize="12sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="@color/white"
                    android:trackTint="@color/brand_orange" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_generate" style="@style/PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/ic_download" android:drawablePadding="8dp"
                android:paddingStart="90dp" android:paddingEnd="90dp"
                android:text="Generate Payload" />
        </LinearLayout>

        <!-- Recent payloads -->
        <LinearLayout style="@style/TrinityCard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Recent Payloads" android:textColor="@color/text_primary"
                android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

            <!-- Empty state -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal" android:paddingVertical="32dp">
                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:src="@drawable/ic_file" android:tint="@color/text_muted" android:alpha="0.6" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="No payloads yet"
                    android:textColor="@color/text_secondary" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:gravity="center"
                    android:text="Generated payloads will appear here"
                    android:textColor="@color/text_muted" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
