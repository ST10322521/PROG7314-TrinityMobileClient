<?xml version="1.0" encoding="utf-8"?><androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Listeners" android:textColor="@color/text_primary"
            android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Manage command &amp; control listeners" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:layout_marginTop="2dp" />

        <!-- Stats row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="16dp">
            <LinearLayout style="@style/TrinityCard" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/LabelCaps" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Total" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/text_primary" android:textSize="22sp"
                    android:textStyle="bold" android:layout_marginTop="4dp" />
            </LinearLayout>
            <LinearLayout style="@style/TrinityCard" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView style="@style/LabelCaps" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Active" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/status_green" android:textSize="22sp"
                    android:textStyle="bold" android:layout_marginTop="4dp" />
            </LinearLayout>
            <LinearLayout style="@style/TrinityCard" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView style="@style/LabelCaps" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Agents" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/brand_orange" android:textSize="22sp"
                    android:textStyle="bold" android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Filter + New -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="14dp">
            <TextView android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
                android:background="@drawable/bg_input" android:gravity="center_vertical"
                android:paddingStart="14dp" android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp" android:text="Filter listeners…"
                android:textColor="@color/text_muted" android:textSize="14sp" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_new_listener" style="@style/PrimaryButton"
                android:layout_width="wrap_content" android:layout_height="46dp"
                android:layout_marginStart="10dp" android:paddingHorizontal="18dp"
                android:drawableStart="@drawable/ic_add" android:drawablePadding="6dp"
                android:text="New" android:minHeight="0dp" />
        </LinearLayout>

        <!-- Listener list goes here once the API layer supplies data. -->
        <LinearLayout
            android:id="@+id/listeners_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <!-- Shared loading / empty / error / success block. See ui/StateView.kt -->
        <Emeris.PROG7314.trinitymobileclient.ui.StateView
            android:id="@+id/state_listeners"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
