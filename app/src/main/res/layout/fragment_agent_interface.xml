<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root">

    <!-- App bar + back button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_appbar_orange"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">
        <ImageButton android:id="@+id/btn_back"
            android:layout_width="42dp" android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back" android:contentDescription="Back" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AGENT-001" android:textColor="@color/white"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Campaign X · Agent Interface" android:textColor="#EEFFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:layout_width="42dp" android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more" android:contentDescription="More" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Endpoint card -->
            <LinearLayout style="@style/TrinityCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_server" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Endpoint Agent" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="EGRESS beacon · Campaign X" android:textColor="@color/text_muted" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green" android:paddingHorizontal="10dp" android:paddingVertical="3dp"
                        android:drawableStart="@drawable/dot_green" android:drawablePadding="6dp"
                        android:text="Active" android:textColor="@color/status_green" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/LabelCaps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IP Address" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="192.168.1.10" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/LabelCaps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OS" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Windows 10" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/LabelCaps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sleep / Jitter" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="60s / 15%" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/LabelCaps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Last Check-in" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="2m ago" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Command console -->
            <LinearLayout style="@style/TrinityCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:drawableStart="@drawable/ic_terminal" android:drawablePadding="8dp"
                        android:text="Command Console" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_page" android:paddingHorizontal="8dp" android:paddingVertical="3dp"
                        android:text="UTF-8" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <TextView android:id="@+id/btn_clear_console" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:background="@drawable/bg_page"
                        android:paddingHorizontal="8dp" android:paddingVertical="3dp"
                        android:text="Clear" android:textColor="@color/text_secondary" android:textSize="11sp"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:background="@drawable/bg_console"
                    android:padding="12dp" android:fontFamily="monospace" android:textSize="11sp"
                    android:textColor="@color/status_green"
                    android:text="Microsoft Windows [Version 10.0.18363.1082]\n\nC:\\Users\\ALKA_DAS&gt; whoami\ndesktop-alka\\operator\n\nC:\\Users\\ALKA_DAS&gt; sysinfo\nOS: Windows 10   Arch: x64   PID: 4821\n\nC:\\Users\\ALKA_DAS&gt; _" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
                    <EditText android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
                        android:background="@drawable/bg_input" android:paddingStart="14dp"
                        android:hint="Enter command for AGENT-001…" android:textColorHint="@color/text_muted"
                        android:textColor="@color/text_primary" android:textSize="14sp" android:inputType="text" />
                    <ImageButton android:id="@+id/btn_send_command"
                        android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="8dp"
                        android:background="@drawable/bg_btn_primary"
                        android:src="@drawable/ic_send" android:contentDescription="Send command" />
                </LinearLayout>
            </LinearLayout>

            <!-- Settings actions -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Settings" android:textColor="@color/text_primary"
                android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_spawnto" style="@style/PrimaryButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:drawableStart="@drawable/ic_add" android:drawablePadding="6dp"
                    android:text="Set SpawnTo" android:textSize="13sp" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_update_hosts" style="@style/PrimaryButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:drawableStart="@drawable/ic_server" android:drawablePadding="6dp"
                    android:text="Update Hosts" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_sleep" style="@style/PrimaryButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:drawableStart="@drawable/ic_bolt" android:drawablePadding="6dp"
                    android:text="Set Sleep" android:textSize="13sp" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_kill" style="@style/DangerButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:drawableStart="@drawable/ic_close_agent" android:drawablePadding="6dp"
                    android:drawableTint="@color/status_red"
                    android:text="Kill Agent" android:textSize="13sp" />
            </LinearLayout>

            <!-- Agent tasks -->
            <LinearLayout style="@style/TrinityCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="60dp" android:layout_height="60dp"
                        android:background="@drawable/bg_avatar" android:gravity="center"
                        android:text="23" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Agent Tasks" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:drawableStart="@drawable/dot_green" android:drawablePadding="6dp"
                                android:text="Successful · 12" android:textColor="@color/text_secondary" android:textSize="12sp" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:drawableStart="@drawable/dot_blue" android:drawablePadding="6dp"
                                android:text="Running · 5" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginTop="2dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:drawableStart="@drawable/dot_yellow" android:drawablePadding="6dp"
                                android:text="Pending · 4" android:textColor="@color/text_secondary" android:textSize="12sp" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:drawableStart="@drawable/dot_red" android:drawablePadding="6dp"
                                android:text="Failed · 2" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Task tabs -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingBottom="6dp" android:background="@drawable/bg_tab_selected"
                        android:text="All" android:textColor="@color/brand_orange" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:paddingBottom="6dp"
                        android:text="Pending" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:paddingBottom="6dp"
                        android:text="Running" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:paddingBottom="6dp"
                        android:text="Failed" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:paddingBottom="6dp"
                        android:text="Successful" android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Create Security Report" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="04/01/26 · 14:20" android:textColor="@color/text_muted" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green" android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                        android:text="Successful" android:textColor="@color/status_green" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Malware Analysis" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="04/01/26 · 14:05" android:textColor="@color/text_muted" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_blue" android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                        android:text="Running" android:textColor="@color/status_blue" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Vulnerability Scan" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="04/01/26 · 13:50" android:textColor="@color/text_muted" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_yellow" android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                        android:text="Pending" android:textColor="@color/status_yellow" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Policy Review" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="04/01/26 · 13:02" android:textColor="@color/text_muted" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_red" android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                        android:text="Failed" android:textColor="@color/status_red" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>

                <include layout="@layout/include_pagination" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
