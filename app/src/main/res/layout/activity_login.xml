<?xml version="1.0" encoding="utf-8"?><androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <Space android:layout_width="match_parent" android:layout_height="24dp" />

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/trinity_logo"
            android:contentDescription="Trinity logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TRINITY"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.25" />

        <Space android:layout_width="match_parent" android:layout_height="36dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/LabelCaps"
            android:text="Team Server" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_focused">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_gravity="center_vertical" android:layout_marginStart="14dp"
                android:src="@drawable/ic_server" />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="44dp"
                android:paddingEnd="60dp"
                android:background="@null"
                android:hint="IP address or domain"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:inputType="text" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end" android:layout_marginEnd="14dp"
                android:text=":50050" android:textColor="@color/brand_orange" android:textSize="13sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_gravity="center_vertical" android:layout_marginStart="14dp"
                android:src="@drawable/ic_person" />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="44dp"
                android:background="@null"
                android:hint="Operator username"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:inputType="text" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_gravity="center_vertical" android:layout_marginStart="14dp"
                android:src="@drawable/ic_key" />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="44dp"
                android:paddingEnd="48dp"
                android:background="@null"
                android:hint="Password"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:inputType="textPassword" />
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:layout_gravity="center_vertical|end" android:layout_marginEnd="14dp"
                android:src="@drawable/ic_eye" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_sign_in"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Connect &amp; Sign In" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:text="or"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_biometrics"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_fingerprint"
            android:drawablePadding="10dp"
            android:paddingStart="90dp"
            android:paddingEnd="90dp"
            android:text="Sign in with biometrics" />

        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="TRINITY · C2 FRAMEWORK"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.1" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
