<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Trinity uses a fixed dark theme to match the design. -->
    <style name="Base.Theme.TrinityMobileClient" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_orange</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Theme.TrinityMobileClient" parent="Base.Theme.TrinityMobileClient" />

    <!-- Reusable widget styles -->
    <style name="TrinityCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/brand_orange</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Destructive action button (e.g. Kill Agent): red instead of orange. -->
    <style name="DangerButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/status_red</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="LabelCaps">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
